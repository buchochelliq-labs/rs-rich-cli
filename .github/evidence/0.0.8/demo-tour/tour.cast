[17.5942, "o", "\u001b[92m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0mParallel exports\u001b[92m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n$ rich --batch --jobs 2 --export-html exports/out.html first.json second.json\r\n"]
[17.6003, "o", "\u001b[1m{\u001b[0m\r\n  \u001b[1;34m\"release\"\u001b[0m: \u001b[32m\"0.0.8\"\u001b[0m,\r\n  \u001b[1;34m\"ready\"\u001b[0m: \u001b[3;92mtrue\u001b[0m\r\n\u001b[1m}\u001b[0m\r\n\u001b[1m{\u001b[0m\r\n  \u001b[1;34m\"features\"\u001b[0m: \u001b[1m[\u001b[0m\r\n    \u001b[32m\"config\"\u001b[0m,\r\n    \u001b[32m\"batch\"\u001b[0m,\r\n    \u001b[32m\"art\"\u001b[0m\r\n  \u001b[1m]\u001b[0m\r\n\u001b[1m}\u001b[0m\r\nCreated first.html and second.html in the temporary demo directory.\r\n"]
