[20.7032, "o", "\u001b[92m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0mPager, input and confidence controls\u001b[92m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n--auto-pager opens a pager for tall TTY output; --no-pager opts out.\r\nURL fetch, encoding, sanitization and JSON reports support scripts and CI.\r\nThe tour stays offline and does not open an external pager.\r\n$ rich --print --sanitize '<ESC>[31m visible controls'\r\n\u241b\u001b[1m[\u001b[0m\u001b[1;36m31\u001b[0mm visible controls\r\n"]
