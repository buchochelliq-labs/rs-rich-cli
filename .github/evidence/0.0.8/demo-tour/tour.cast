[5.5364, "o", "\u001b[92m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0mtable\u001b[92m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n\u001b[3m           ported renderables            \u001b[0m\r\n\u250f\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2533\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2513\r\n\u2503\u001b[1m \u001b[0m\u001b[1mRenderable   \u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mModule      \u001b[0m\u001b[1m \u001b[0m\u2503\u001b[1m \u001b[0m\u001b[1mParity\u001b[0m\u001b[1m \u001b[0m\u2503\r\n\u2521\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2547\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2529\r\n\u2502\u001b[36m \u001b[0m\u001b[36mText / markup\u001b[0m\u001b[36m \u001b[0m\u2502 text, markup \u2502   \u2713    \u2502\r\n\u2502\u001b[36m \u001b[0m\u001b[36mRule         \u001b[0m\u001b[36m \u001b[0m\u2502 rule         \u2502   \u2713    \u2502\r\n\u2502\u001b[36m \u001b[0m\u001b[36mPanel        \u001b[0m\u001b[36m \u001b[0m\u2502 panel        \u2502   \u2713    \u2502\r\n\u2502\u001b[36m \u001b[0m\u001b[36mPadding      \u001b[0m\u001b[36m \u001b[0m\u2502 padding      \u2502   \u2713    \u2502\r\n\u2502\u001b[36m \u001b[0m\u001b[36mAlign        \u001b[0m\u001b[36m \u001b[0m\u2502 align        \u2502   \u2713    \u2502\r\n\u2502\u001b[36m \u001b[0