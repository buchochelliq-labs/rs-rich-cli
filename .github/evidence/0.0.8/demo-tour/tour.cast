[16.0923, "o", "\r\n                                        \u001b[1;4mNotebook\u001b[0m                                        \r\n\r\nRich renders notebook cells.                                                            \r\n\r\n\u001b[32mIn [\u001b[0m\u001b[38;2;102;255;0m1\u001b[0m\u001b[32m]:\u001b[0m\r\n\u001b[2m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n\u001b[2m\u2502\u001b[0m \u001b[38;2;150;181;180;48;2;43;48;59mprint\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m(\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m'\u001b[0m\u001b[38;2;163;190;140;48;2;43;48;59mvroom vroom\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m'\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m)\u001b[0m\u001b[48;2;43;48;59m                                                                \u001b[0m \u001b[2m\u2502\u001b[0m\r\n\u001b[2m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\nvroom vroom\r\n"]
[16.5927, "o", "\u001b[92m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0mConfiguration profiles\u001b[92m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n$ rich --config demo.toml --profile preview config show\r\n"]
[16.5931, "o", "\u001b[1m{\u001b[0m\r\n  \u001b[1;34m\"valid\"\u001b[0m: \u001b[3;92mtrue\u001b[0m,\r\n  \u001b[1;34m\"source\"\u001b[0m: \u001b[32m\"/tmp/tmprcw55zm7/.tmpm8HxY9/demo.toml\"\u001b[0m,\r\n  \u001b[1;34m\"profile\"\u001b[0m: \u001b[32m\"preview\"\u001b[0m,\r\n  \u001b[1;34m\"disabled\"\u001b[0m: \u001b[3;91mfalse\u001b[0m,\r\n  \u001b[1;34m\"settings\"\u001b[0m: \u001b[1m{\u001b[0m\r\n    \u001b[1;34m\"panel\"\u001b[0m: \u001b[32m\"rounded\"\u001b[0m,\r\n    \u001b[1;34m\"width\"\u001b[0m: \u001b[1;36m60\u001b[0m\r\n  \u001b[1m}\u001b[0m\r\n\u001b[1m}\u001b[0m\r\n$ rich --config demo.toml --profile preview first.json\r\n"]
[16.5933, "o", "\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\r\n\u2502 \u001b[1m{\u001b[0m                                                        \u2502\r\n\u2502   \u001b[1;34m\"release\"\u001b[0m: \u001b[32m\"0.0.8\"\u001b[0m,                                    \u2502\r\n\u2502   \u001b[1;34m\"ready\"\u001b[0m: \u001b[3;92mtrue\u001b[0m                                          \u2502\r\n\u2502 \u001b[1m}\u001b[0m                                                        \u2502\r\n\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\r\n"]
[17.0936, "o", "\u001b[92m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0mBatch planning\u001b[92m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\r\n"]
