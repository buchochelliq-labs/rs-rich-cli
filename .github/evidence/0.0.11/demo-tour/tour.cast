[10.6154, "o", "                                        \u001b[1;4mHeading\u001b[0m                                         \r\n\r\nA paragraph with \u001b[1mbold\u001b[0m, \u001b[3mitalic\u001b[0m, \u001b[1;36;40mcode\u001b[0m, \u001b[9mstruck\u001b[0m text, and a \u001b]8;;https://example.com\u001b\\\u001b[4;34mlink\u001b[0m\u001b]8;;\u001b\\. Tilde runs pair as        \r\nupstream pairs them: a ~\u001b[9mx\u001b[0m~ b.                                                           \r\n\r\n\u001b[1m \u2022 \u001b[0mbullet item                                                                          \r\n\u001b[1m \u2022 \u001b[0manother                                                                              \r\n\r\n\u001b[36m 1 \u001b[0mfirst                                                                                \r\n\u001b[36m 2 \u001b[0msecond                                                                               \r\n\r\n\u001b[35m\u258c \u001b[0m\u001b[35ma block quote\u001b[0m\u001b[35m                                                                       \u001b[0m\r\n\r\n\u001b[36m            \u001b[0m\r\n\u001b[36m \u001b[0m\u001b[36mName\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mAge\u001b[0m\u001b[36m \u001b[0m\r\n\u001b[36m \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 \u001b[0m\r\n\u001b[36m \u001b[0mAlice \u001b[36m \u001b[0m 30\u001b[36m \u001b[0m\r\n\u001b[36m \u001b[0mBob   \u001b[36m \u001b[0m  7\u001b[36m \u001b[0m\r\n\u001b[36m            \u001b[0m\r\n\r\n\u001b[48;2;43;48;59m                                                                                        \u001b[0m\r\n\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;180;142;173;48;2;43;48;59mfn\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m \u001b[0m\u001b[38;2;143;161;179;48;2;43;48;59mmain\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m(\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m)\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m \u00