[5.343,"o","\r\nrich: warning: guide.adoc:69: include::appendix.adoc[] is not followed; it is shown as written\r\n                                          \u001b[1;4mThe Field Guide\u001b[0m                                           \r\n                         \u001b[2mAda Lovelace <ada@example.com> · v2.1, 2026-10-01\u001b[0m                          \r\n\r\nThe Analytical Engine reads \u001b[1mstrong\u001b[0m, \u001b[3memphasis\u001b[0m, \u001b[1;36;40mmonospace\u001b[0m and \u001b[30;43mhighlighted\u001b[0m text, with \u001b[1mun\u001b[0mconstrained    \r\nmarks, © symbols — and a footnote.\u001b[2m[1]\u001b[0m                                                               \r\n\r\n\u001b[4;35mGetting started\u001b[0m                                                                                     \r\n\r\n\u001b[1;36m╭─\u001b[0m\u001b[1;36m Note \u001b[0m\u001b[1;36m──────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[1;36m─╮\u001b[0m\r\n\u001b[1;36m│\u001b[0m Read the whole guide before you begin.                                                           \u001b[1;36m│\u001b[0m\r\n\u001b[1;36m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n\r\n\u001b[2;3mInstall it\u001b[0m\r\n\u001b[48;2;43;48;59m                                                                                                    \u001b[0m\r\n\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;143;161;179;48;2;43;48;59mcargo\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m install rs-rich-cli \u001b[0m\u001b[38;2;101;115;126;48;2;43;48;59m#\u001b[0m\u001b[38;2;101;115;126;48;2;43;48;59m \u001b[0m\u001b[1;7;38;2;101;115;126;48;2;43;48;59m<1>\u001b[0m\u001b[48;2;43;48;59m                                                                   \u001b[0m\u001b[48;2;43;48;59m \u001b[0m\r\n\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;143;161;179;48;2;43;48;59mrich\u001b[0m\u001b[38;2;191;97;106;48;2;43;48;59m --\u001b[0m\u001b[38;2;191;97;106;48;2;43;48;59mversion            \u001b[0m\u001b[38;2;101;115;126;48;2;43;48;59m#\u001b[0m\u001b[38;2;101;115;126;48;2;43;48;59m \u001b[0m\u001b[1;7;38;2;101;115;126;48;2;43;48;59m<2>\u001b[0m\u001b[48;2;43;48;59m                                                                   \u001b[0m\u001b[48;2;43;48;59m \u001b[0m\r\n\u001b[48;2;43;48;59m                                                                                                    \u001b[0m\r\n\r\n\u001b[1;7m <1> \u001b[0mInstalls the \u001b[1;36;40mrich\u001b[0m binary.                                                                      \r\n\u001b[1;7m <2> \u001b[0mPrints its version.                                                                            \r\n\r\n\u001b[1;35mLists\u001b[0m                                                                                               \r\n\r\n\u001b[1m • \u001b[0mUnordered                                                                                        \r\n   \u001b[1m • \u001b[0mNested deeper                                                                                 \r\n\u001b[1m • \u001b[0m\u001b[1;32m[x] \u001b[0mChecked off                                                                                  \r\n\u001b[1m • \u001b[0m\u001b[1m[ ] \u001b[0mStill to do                                                                                  \r\n\r\n\u001b[36m 1 \u001b[0mFirst                                                                                            \r\n\u001b[36m 2 \u001b[0mSecond                                                                                           \r\n                                                                                                    \r\n   A paragraph attached with a list continuation.                                                   \r\n\r\n\u001b[1mCPU\u001b[0m\r\n    The processing unit                                                       