[8.639,"o","\r\n\u001b[2mGREET(1)                                   User Commands                                    GREET(1)\u001b[0m\r\n\r\n\u001b[4;35mNAME\u001b[0m                                                                                                \r\n\r\ngreet - print a friendly greeting                                                                   \r\n\r\n\u001b[4;35mSYNOPSIS\u001b[0m                                                                                            \r\n\r\n\u001b[1mgreet \u001b[0m[\u001b[1m-n \u001b[0m\u001b[3mcount\u001b[0m] [\u001b[1m--shout\u001b[0m] \u001b[3mname\u001b[0m...                                                                  \r\n\r\n\u001b[4;35mDESCRIPTION\u001b[0m                                                                                         \r\n\r\n\u001b[1mgreet \u001b[0mwrites a greeting for each \u001b[3mname \u001b[0mto standard output. The greeting is “Hello” unless \u001b[1m--shout \u001b[0m   \r\nsays otherwise — then it is louder.                                                                 \r\n\r\n\u001b[1;35mOptions\u001b[0m                                                                                             \r\n\r\n\u001b[1m-n\u001b[0m\u001b[1m, \u001b[0m\u001b[1m--count\u001b[0m\u001b[1m=\u001b[0m\u001b[1;3mN\u001b[0m\r\n    Repeat each greeting \u001b[3mN \u001b[0mtimes.                                                                   \r\n\r\n\u001b[1m-s\u001b[0m\u001b[1m, \u001b[0m\u001b[1m--shout\u001b[0m\r\n    Write the greeting in capitals.                                                                 \r\n                                                                                                    \r\n        \u001b[1m • \u001b[0mWorks with every name.                                                                   \r\n        \u001b[1m • \u001b[0mIgnores the locale.                                                                      \r\n\r\n\u001b[4;35mEXAMPLES\u001b[0m                                                                                            \r\n\r\n\u001b[48;2;43;48;59m                                                                                                    \u001b[0m\r\n\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m$ greet -n 2 world\u001b[0m\u001b[48;2;43;48;59m                                                                                \u001b[0m\u001b[48;2;43;48;59m \u001b[0m\r\n\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mHello, world\u001b[0m\u001b[48;2;43;48;59m                                                                                      \u001b[0m\u001b[48;2;43;48;59m \u001b[0m\r\n\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mHello, world\u001b[0m\u001b[48;2;43;48;59m                                                                                      \u001b[0m\u001b[48;2;43;48;59m \u001b[0m\r\n\u001b[48;2;43;48;59m                                                                                                    \u001b[0m\r\n\r\n\u001b[4;35mFILES\u001b[0m                                                                                               \r\n\r\n\u001b[1;35m❯\u001b[0m "]
