                                                                       \r\n\u001b[1m • \u001b[0m\u001b[1;33m[-] \u001b[0mWide characters: 漢字 and emoji                                                              \r\n\r\n\u001b[1;35mGlossary\u001b[0m                                                                                            \r\n\r\n\u001b[1mHeadline\u001b[0m\r\n    a line of stars and a title                                                                     \r\n\r\n\u001b[1mDrawer\u001b[0m\r\n    metadata between \u001b[1;36;40m:NAME:\u001b[0m and \u001b[1;36;40m:END:\u001b[0m                                                               \r\n\r\n\u001b[4;35mExamples\u001b[0m                                                                                            \r\n\r\n    \u001b[2;3mSizes by kind\u001b[0m    \r\n\u001b[36m                     \u001b[0m\r\n\u001b[36m \u001b[0m\u001b[36mKind\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mCount\u001b[0m\u001b[1m \u001b[0m\u001b[36m \u001b[0m\u001b[36mShare\u001b[0m\u001b[36m \u001b[0m\r\n\u001b[36m ─────────────────── \u001b[0m\r\n\u001b[36m \u001b[0mlists \u001b[36m \u001b[0m   12 \u001b[36m \u001b[0m 40% \u001b[36m \u001b[0m\r\n\u001b[1;35m❯\u001b[0m "]
