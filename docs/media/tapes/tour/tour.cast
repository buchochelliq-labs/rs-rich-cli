[74.515,"o","\u001b[1;38;2;177;182;191;48;2;43;48;59m  \u001b[0m\u001b[38;2;87;92;103;48;2;43;48;59m1 \u001b[0m\u001b[38;2;180;142;173;48;2;43;48;59mfn\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m \u001b[0m\u001b[38;2;143;161;179;48;2;43;48;59mretry\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m(\u001b[0m\u001b[38;2;191;97;106;48;2;43;48;59mjob\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m:\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m&\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mJob, \u001b[0m\u001b[38;2;191;97;106;48;2;43;48;59mattempts\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m:\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m \u001b[0m\u001b[38;2;180;142;173;48;2;43;48;59mu32\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m)\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m->\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mResult\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m<\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m(\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m)\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m, Error\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m>\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m{\u001b[0m\u001b[48;2;43;48;59m                           \u001b[0m\r\n\u001b[1;38;2;177;182;191;48;2;43;48;59m  \u001b[0m\u001b[38;2;87;92;103;48;2;43;48;59m2 \u001b[0m\u001b[2;38;2;101;115;126;48;2;43;48;59m│   \u001b[0m\u001b[38;2;180;142;173;48;2;43;48;59mfor\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m n \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59min\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m \u001b[0m\u001b[38;2;208;135;112;48;2;43;48;59m0\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m..\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mattempts \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m{\u001b[0m\u001b[48;2;43;48;59m                                                          \u001b[0m\r\n\u001b[1;38;2;177;182;191;48;2;43;48;59m  \u001b[0m\u001b[38;2;87;92;103;48;2;43;48;59m3 \u001b[0m\u001b[2;38;2;101;115;126;48;2;43;48;59m│   │   \u001b[0m\u001b[38;2;180;142;173;48;2;43;48;59mif\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m job.\u001b[0m\u001b[38;2;150;181;180;48;2;43;48;59mrun\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m(\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m)\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m.\u001b[0m\u001b[38;2;150;181;180;48;2;43;48;59mis_ok\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m(\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m)\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m{\u001b[0m\u001b[48;2;43;48;59m                                                      \u001b[0m\r\n\u001b[1;38;2;177;182;191;48;2;43;48;59m  \u001b[0m\u001b[38;2;87;92;103;48;2;43;48;59m4 \u001b[0m\u001b[2;38;2;101;115;126;48;2;43;48;59m│   │   │   \u001b[0m\u001b[38;2;180;142;173;48;2;43;48;59mreturn\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mOk\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m(\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m(\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m)\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m)\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m;\u001b[0m\u001b[48;2;43;48;59m                                                          \u001b[0m\r\n\u001b[1;38;2;177;182;191;48;2;43;48;59m  \u001b[0m\u001b[38;2;87;92;103;48;2;43;48;59m5 \u001b[0m\u001b[2;38;2;101;115;126;48;2;43;48;59m│   │   \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m}\u001b[0m\u001b[48;2;43;48;59m                                                                           \u001b[0m\r\n"]
[76.016,"o","\u001b[92m─────────────────────────────────── \u001b[0mreStructuredText\u001b[92m ───────────────────────────────────\u001b[0m\r\n"]
[76.017,"o","$ rich --rst release.rst\r\n"]
[76.071,"o","\u001b[1m╔══════════════════════════════════════════════════════════════════════════════════════╗\u001b[0m\r\n\u001b[1m║\u001b[0m\u001b[1m \u001b[0m\u001b[1m                                   \u001b[0m\u001b[1mRelease 0.0.13\u001b[0m\u001b[1m                                   \u001b[0m\u001b[1m \u001b[0m\u001b[1m║\u001b[0m\r\n\u001b[1m╚══════════════════════════════════════════════════════════════════════════════════════╝\u001b[0m\r\n\u001b[39;49mAsk, choose and browse from a script:\u001b[0m\r\n\r\n\u001b[1;33m • \u001b[0mrich choose picks one item\r\n\u001b[1;33m • \u001b[0mrich filter narrows a list as you type\r\n\u001b[1;33m • \u001b[0mrich confirm answers with its exit code\r\n\r\n\u001b[1;37m╭─\u001b[0m\u001b[1;37m──────────────────────────────────────\u001b[0m\u001b[1;37m Note:  \u001b[0m\u001b[1;37m──────────────────────────────────────\u001b[0m\u001b[1;37m─╮\u001b[0m\r\n\u001b[1;37m│\u001b[0m\u001b[1;37m \u001b[0m\u001b[1;37mKeys come from the terminal even when stdin is the list.\u001b[0m\u001b[1;37m                            \u001b[0m\u001b[1;37m \u001b[0m\u001b[1;37m│\u001b[0m\r\n\u001b[1;37m╰──────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[77.573,"o","\u001b[92m─────────────────────────────────── \u001b[0mAsk in a script\u001b[92m ────────────────────────────────────\u001b[0m\r\n$ fruit=$(rich choose apple banana cherry)   # ↓ then Enter\r\n"]
[77.574,"o","╭──────────────────── drawn headless: the keys a user would press ─────────────────────╮\r\n│ ? Pick a fruit ›                                                                     │\r\n│   apple                                                                              │\r\n│ ❯ banana                                                                             │\r\n│   cherry                                                                             │\r\n│   3/3 · ↑↓ move · enter pick · esc cancel                                            │\r\n╰──────────────────────────────────────────────────────────────────────────────────────╯\r\n"]
[77.575,"o","$ echo \"$fruit\"\r\nbanana\r\n$ ls | rich filter --value toml    # without a terminal: a fuzzy grep\r\n$ rich confirm 'Deploy?' && deploy  # exit 0 for yes, 1 for no\r\n"]
[79.075,"o","\u001b[92m───────────────────────── \u001b[0mPager, input and confidence controls\u001b[92m ─────────────────────────\u001b[0m\r\n"]
[79.076,"o","--auto-pager opens a pager for tall TTY output; --no-pager opts out.\r\nURL fetch, encoding, sanitization and JSON reports support scripts and CI.\r\nThe tour stays offline and does not open an external pager.\r\n$ rich --print --sanitize '<ESC>[31m visible controls'\r\n"]
[79.077,"o","␛\u001b[1m[\u001b[0m\u001b[1;36m31\u001b[0mm visible controls\r\n"]
