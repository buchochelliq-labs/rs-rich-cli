[1.632,"o","\u001b[17A\r\u001b[1C\u001b[38;2;192;197;206;48;2;43;48;59muse rich_record::{record, tape};\u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m                                                                            \u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mlet tape = tape::parse(&std::fs::read_to_string(\"demo.tape\")?)?;\u001b[0m\u001b[48;2;43;48;59m           \u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mlet recording = record::record(&tape, \"demo\", \u001b[0m\u001b[48;2;43;48;59m                             \u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m&record::Options::default())?;\u001b[0m\u001b[48;2;43;48;59m                                             \u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mlet problems = record::check(&recording, \"media/demo\".as_ref());\u001b[0m\u001b[48;2;43;48;59m           \u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59massert!(problems.is_empty(), \"{problems:?}\");\u001b[0m\u001b[48;2;43;48;59m                              \u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m# Ok::<(), Box<dyn std::error::Error>>(())\u001b[0m\u001b[48;2;43;48;59m                                 \u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m                                                                            \u001b[0m\u001b[2B\rFrom the shell, th\r\u001b[19C \u001b[1;36;40mrich\u001b[0m CLI (\u001b[1;36;40mrs-rich-cli\u001b[0m)\r\u001b[43Chas \u001b[1;36;40mrich record TAPE…\u001b[0m.          \u001b[1B\r\u001b[K\u001b[1B\rLinux and macOS are supported. Windows builds through ConPTY but needs \u001b[1;36;40mbash\u001b[0m \u001b[1B\ron \u001b[1;36;40mPATH\u001b[0m, and is experimental.                                               \u001b[1B\r\u001b[K\u001b[1B\rText in PNG and GIF output uses DejaVu Sans Mono, embedded in the crate     \u001b[1B\runder the Bitstream Vera licence (see \u001b[1;36;40mfonts/LICENSE-DejaVu\u001b[0m).                \u001b[1B\r\u001b[6C\u001b[2m35\u001b[0m\r\u001b[9C\u001b[2m51\u001b[0m"]
