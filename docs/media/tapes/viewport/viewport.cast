[0.763,"o","\r                               \u001b[1;4mrs-rich-record\u001b[0m                               \r\n\r\r\n\rRecord scripted terminal sessions (\u001b[1mtapes\u001b[0m) into screenshots, asciinema casts,\r\n\rGIF and MP4. Part of \u001b]8;;https://github.com/buchochelliq-labs/rs-rich-cli\u001b\\\u001b[4;34mrs-rich\u001b[0m\u001b]8;;\u001b\\, the Rust port of Python's \u001b[1;36;40mrich\u001b[0m. This crate is \r\n\ran rs-rich addition, not a port.                                            \r\n\r\r\n\rA tape scripts a session, one step per line:                                \r\n\r\r\n\r\u001b[48;2;43;48;59m                                                                            \u001b[0m\r\n\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mSet Size 90x22\u001b[0m\u001b[48;2;43;48;59m                                                             \u001b[0m\r\n\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mSet Title \"rich --watch · re-render on save\"\u001b[0m\u001b[48;2;43;48;59m                               \u001b[0m\r\n\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mWrite service.json '{\"replicas\": 2}'\u001b[0m\u001b[48;2;43;48;59m                                       \u001b[0m\r\n\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mType \"rich --watch service.json\"\u001b[0m\u001b[48;2;43;48;59m                                           \u001b[0m\r\n\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mEnter\u001b[0m\u001b[48;2;43;48;59m                                                                      \u001b[0m\r\n\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mWait /\"replicas\": 2/\u001b[0m\u001b[48;2;43;48;59m                                                       \u001b[0m\r\n\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mScreenshot before\u001b[0m\u001b[48;2;43;48;59m                                                          \u001b[0m\r\n\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59mExec \"sed -i 's/2/5/' service.json\"\u001b[0m\u001b[48;2;43;48;59m                                        \u001b[0m\r\n\r\u001b[2mlines 1–17 of 56 · ↑↓ PgUp PgDn · q quits\u001b[0m"]
