[1.637,"o","\u001b[17A\r\u001b[1C\u001b[38;2;192;197;206;48;2;43;48;59mlet problems = record::check(&recording, \"media/demo\".as_ref());\u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59massert!(problems.is_empty(), \"{problems:?}\");\u001b[0m\u001b[48;2;43;48;59m                              \u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m# Ok::<(), Box<dyn std::error::Error>>(())\u001b[0m\u001b[48;2;43;48;59m                                 \u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m                                                                            \u001b[0m\u001b[2B\rFrom the shell, the \u001b[1;36;40mrich\u001b[0m\r\u001b[25CCLI (\u001b[1;36;40mrs-rich-cli\u001b[0m) h\r\u001b[45Cs\r\u001b[47C\u001b[1;36;40mrich record TAPE…\u001b[0m. \r\u001b[67C     \r\u001b[73C   \u001b[1B\r\u001b[K\u001b[1B\rLinux\r\u001b[7Cnd macOS\r\u001b[16Care supported. Windows builds through ConPTY bu\r\u001b[64C ne\r\u001b[68Cds \u001b[1;36;40mbash\u001b[0m\u001b[1B\ron \u001b[1;36;40mPATH\u001b[0m,\r\u001b[9Cand is\r\u001b[16Cexperimental.   \r\u001b[33C  \r\u001b[36C   \r\u001b[40C    \r\u001b[45C      \r\u001b[52C  \r\u001b[55C          \u001b[2B\rText in PNG and GIF output\r\u001b[27Cuses\r\u001b[32CDejaVu Sans Mono, \r\u001b[51Cmbedded\r\u001b[59Cin\r\u001b[62Cthe cra\r\u001b[70Ce    \u001b[1B\run\r\u001b[3Cer\r\u001b[6Cthe Bitstream Vera licence (see \u001b[1;36;40mfonts/LICENSE-DejaVu\u001b[0m).\r\u001b[61CEmoji\r\u001b[67Care\r\u001b[71Cdrawn\u001b[1B\rin colour from Twemoji, also embedded, under CC BY 4.0 (see                 \u001b[1B\r\u001b[1;36;40mfonts/LICENSE-Twemoji\u001b[0m). Each emoji cluster (ZWJ sequences, skin tones,      \u001b[1B\rflags, ❤️, keycaps) takes one cell as wide as rich measures it, and         \u001b[1B\rbox-drawing, block and braille characters are drawn as geometry, so borders \u001b[1B\rjoin and block images have no seams.                                        \u001b[1B\r\u001b[6C\u001b[2m40\u001b[0m\r\u001b[9C\u001b[2m56\u001b[0m"]
