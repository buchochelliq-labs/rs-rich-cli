[1.517,"o","\u001b[17A\r\u001b[1C\u001b[48;2;43;48;59m      \u001b[0m\u001b[1B\r\u001b[K\u001b[1B\rThe recorder runs it in \u001b[1;36;40mbash\u001b[0m on a real PTY with a pinned environment,       \u001b[1B\rfollows th\r\u001b[11C screen with\r\u001b[24Ca VT\r\u001b[29Cemulator,\r\u001b[39Cand\r\u001b[44Crites:      \r\u001b[57C            \u001b[1B\r\u001b[K\u001b[1B\r\u001b[1m • \u001b[0mper \u001b[1;36;40mScreenshot\u001b[0m: a PNG in a window frame, an SVG with selectable text, and\u001b[1B\r\u001b[1C\u001b[1m \u001b[0m\r\u001b[3Ca text grid;   \r\u001b[19C \r\u001b[21C   \r\u001b[25C  \r\u001b[28C \r\u001b[30C      \r\u001b[37C      \r\u001b[44C  \r\u001b[47C   \r\u001b[51C    \r\u001b[56C          \r\u001b[67C     \r\u001b[73C   \u001b[1B\r\u001b[1C\u001b[1m•\u001b[0m\r\u001b[4Cn asciinema\r\u001b[16Cv2\r\u001b[19Ccast,\r\u001b[25Cwith\r\u001b[30Cinput\r\u001b[36Cevents\r\u001b[43Cand\r\u001b[47Cthe\r\u001b[51Cpalette\r\u001b[59Cin\r\u001b[62Cits\r\u001b[66Cheader;\u001b[1B\r\u001b[4C GIF w\r\u001b[11Cth \r\u001b[16Ckey overlay, and an\r\u001b[36CMP4 when FFmp\r\u001b[50Cg is installed.\r\u001b[66C       \u001b[1B\r\u001b[K\u001b[1B\r\u001b[1;36;40mcheck\u001b[0m compares a new run's text grids with committed ones, so documentation \u001b[1B\rmedia\r\u001b[7Cannot drift from the program it shows.       \r\u001b[53C     \r\u001b[59C  \r\u001b[62C             \u001b[1B\r\u001b[K\u001b[1B\r\u001b[48;2;43;48;59m                                                                            \u001b[0m\u001b[1B\r\u001b[1C\u001b[38;2;192;197;206;48;2;43;48;59muse rich_record::{record, tape};\u001b[0m\u001b[1B\r\u001b[1C\u001b[48;2;43;48;59m                                \u001b[0m\u001b[1B\r\u001b[1C\u001b[38;2;192;197;206;48;2;43;48;59mlet tape = tape::parse(&std::fs::read_to_string(\"demo.tape\")?)?;\u001b[0m\u001b[1B\r\u001b[7C\u001b[2m1\u001b[0m\r\u001b[10C\u001b[2m7\u001b[0m"]
