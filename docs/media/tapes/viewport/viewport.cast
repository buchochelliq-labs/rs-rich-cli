[1.265,"o","\u001b[17A\r\u001b[36m \u001b[0m\u001b[1;36;40mretries\u001b[0m\r\u001b[9C\u001b[36m \u001b[0m3\r\u001b[18C\u001b[36m \u001b[0mTries\r\u001b[25Cbefore\r\u001b[32Ca\r\u001b[34Cjob fails\r\u001b[48C\u001b[36m \u001b[0m\u001b[K\u001b[1B\r\u001b[36m \u001b[0m\u001b[1;36;40mport\u001b[0m    \u001b[36m \u001b[0m8080    \u001b[36m \u001b[0mWhere the status page listens\u001b[36m \u001b[0m\u001b[1B\r\u001b[36m                                                 \u001b[0m\u001b[K\u001b[1B\r\u001b[K\u001b[1B\r\u001b[4;35mRunning it\u001b[0m                                                                  \u001b[1B\r\u001b[K\u001b[1B\r\u001b[48;2;43;48;59m                                                                            \u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m \u001b[0m\u001b[38;2;143;161;179;48;2;43;48;59morbit\u001b[0m\u001b[38;2;191;97;106;48;2;43;48;59m --workers\u001b[0m\u001b[38;2;192;197;206;48;2;43;48;59m 8 queue.toml\u001b[0m\u001b[48;2;43;48;59m                                               \u001b[0m\u001b[1B\r\u001b[48;2;43;48;59m                                                                            \u001b[0m\u001b[1B\r\u001b[K\u001b[1B\rThe status page shows each worker, its job and how long it has run. A worker\u001b[1B\rthat has run a\r\u001b[15Cjob\r\u001b[19Cfor\r\u001b[23Cmore\r\u001b[28Cthan\r\u001b[33Ca\r\u001b[35Cminute\r\u001b[42Cis\r\u001b[45Cmarked\r\u001b[52Cslow;\r\u001b[58Ca\r\u001b[60Cjob\r\u001b[64Cthat\r\u001b[69Cfailed\u001b[1B\rthree times is listed with its last error.                                  \u001b[1B\r\u001b[K\u001b[1B\r\u001b[4;35mComponents\u001b[0m                                                                  \u001b[1B\r\u001b[K\u001b[1B\rThe terminal\r\u001b[13Cside\r\u001b[18Cis \r\u001b[22Cuilt from rs-rich-interact components: a picker for   \u001b[1B\r\u001b[7C\u001b[2m8–34 of 52 · ↑↓ PgUp PgDn · q quits\u001b[0m"]
