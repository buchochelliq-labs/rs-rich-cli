[13.165,"o","\r\n\u001b[1m╔══════════════════════════════════════════════════════════════════════════════════════════════╗\u001b[0m\r\n\u001b[1m║\u001b[0m\u001b[1m \u001b[0m\u001b[1m                                       \u001b[0m\u001b[1mRelease 0.0.13\u001b[0m\u001b[1m                                       \u001b[0m\u001b[1m \u001b[0m\u001b[1m║\u001b[0m\r\n\u001b[1m╚══════════════════════════════════════════════════════════════════════════════════════════════╝\u001b[0m\r\n\u001b[39mAsk, choose and browse from a script:\u001b[0m\r\n\r\n\u001b[1;33m • \u001b[0m\u001b[1;38;5;251;48;5;233mrich choose\u001b[0m\u001b[39;48;5;233m picks one item\u001b[0m\r\n\u001b[1;33m • \u001b[0m\u001b[1;38;5;251;48;5;233mrich filter\u001b[0m\u001b[39;48;5;233m narrows a list as you type\u001b[0m\r\n\u001b[1;33m • \u001b[0m\u001b[1;38;5;251;48;5;233mrich confirm\u001b[0m\u001b[39;48;5;233m answers with its exit code\u001b[0m\r\n\r\n\u001b[1;37m╭─\u001b[0m\u001b[1;37m───────────────────────────────────────────\u001b[0m\u001b[1;37m Note \u001b[0m\u001b[1;37m───────────────────────────────────────────\u001b[0m\u001b[1;37m─╮\u001b[0m\r\n\u001b[1;37m│\u001b[0m \u001b[39mKeys come from the terminal even when stdin is the list.\u001b[0m                                     \u001b[1;37m│\u001b[0m\r\n\u001b[1;37m╰──────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n\u001b[1;35m❯\u001b[0m "]
