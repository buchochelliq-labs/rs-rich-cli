{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/order.schema.json",
  "title": "Order",
  "description": "A customer's order.",
  "type": "object",
  "required": ["id", "items"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^ord_[a-z0-9]+$", "description": "Order id."},
    "status": {"enum": ["pending", "paid", "shipped"], "default": "pending"},
    "customer": {"$ref": "#/$defs/customer"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    },
    "payment": {
      "oneOf": [
        {"title": "Card", "type": "object", "required": ["last4"], "properties": {"last4": {"type": "string", "minLength": 4, "maxLength": 4}}},
        {"title": "Invoice", "type": "object", "properties": {"due": {"type": "string", "format": "date"}}}
      ]
    },
    "notes": {"type": ["string", "null"], "maxLength": 500}
  },
  "$defs": {
    "customer": {
      "type": "object",
      "required": ["email"],
      "properties": {
        "email": {"type": "string", "format": "email"},
        "referrer": {"$ref": "#/$defs/customer", "description": "Who referred them."}
      }
    },
    "item": {
      "type": "object",
      "required": ["sku", "quantity"],
      "properties": {
        "sku": {"type": "string"},
        "quantity": {"type": "integer", "minimum": 1},
        "price": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
