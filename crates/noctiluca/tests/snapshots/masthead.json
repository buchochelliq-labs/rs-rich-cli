 it. The page is read\n     scrolled down, as after the reader scrolled: the skip link is then\n     well inside the document, still far above the viewport. */\n  body { margin: 0; font: 14px/20px sans-serif; }\n  #bar { position: fixed; top: 0; left: 0; right: 0; height: 56px;\n         display: flex; align-items: center; justify-content: space-between;\n         padding: 0 16px; background: #fff; }\n  #start { display: flex; align-items: center; position: relative; }\n  #skip { position: absolute; top: -1000px; left: 16px; }\n  #skip:focus { top: 8px; }\n  #guide { width: 40px; height: 40px; }\n  #logo { margin-left: 16px; width: 90px; height: 20px; background: #c00;\n          color: #fff; font: bold 12px/20px sans-serif; text-align: center; }\n  #center { display: flex; align-items: center; }\n  #search { width: 360px; height: 40px; box-sizing: border-box;\n            padding: 0 12px; border: 1px solid #ccc; border-radius: 20px 0 0 20px; }\n  #go, #voice { height: 40px; }\n  #voice { margin-left: 12px; border-radius: 20px; }\n  #end { display: flex; align-items: center; }\n  #end button { height: 36px; }\n  main { padding: 72px 16px 0; height: 3000px; }\n  main p { margin: 0 0 12px; }\n","BODY","DIV","id","bar","flex","rgb(255, 255, 255)","fixed","\n  ","start","relative","\n    ","BUTTON","skip","rgb(239, 239, 239)","absolute","Skip navigation","guide","aria-label","Guide","☰","logo","rgb(204, 0, 0)","700","ClipTube","center","INPUT","search","type","text","name","q","placeholder","Search","clip","go","Go","voice","Voice","end","Settings","Sign in","MAIN","P","First result: the glowing coast at night.","Second result: waves under the pier.","SCRIPT","scrollTo(0, 1500);","\n\n\n"]},"ax":{"nodes":[{"nodeId":"2","ignored":false,"role":{"type":"internalRole","value":"RootWebArea"},"chromeRole":{"type":"internalRole","value":144},"name":{"type":"computedString","value":"Masthead","sources":[{"type":"relatedElement","attribute":"aria-labelledby"},{"type":"attribute"