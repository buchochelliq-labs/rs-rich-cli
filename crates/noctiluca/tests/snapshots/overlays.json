 flex; gap: 12px; margin: 12px; }\n  .thumb { position: relative; width: 320px; height: 180px; }\n  .thumb img { width: 320px; height: 180px; display: block; }\n  .badge { position: absolute; background: #000; color: #fff; font-size: 12px; padding: 0 4px; }\n  .duration { right: 6px; bottom: 6px; }\n  .live { left: 6px; top: 6px; background: #e91916; }\n  .viewers { left: 6px; bottom: 6px; }\n  .panel { position: relative; width: 640px; height: 120px; margin: 12px; }\n  .panel .error { padding: 8px; }\n  .panel .interstitial { position: absolute; inset: 0; background: #fff; padding: 8px; }\n  .join { position: fixed; bottom: 0; left: 0; right: 0; background: #9147ff; color: #fff; padding: 6px 12px; }\n","BODY","rgb(14, 14, 16)","DIV","class","top","flex","rgb(255, 255, 255)","rgb(24, 24, 27)","fixed","\n  ","A","href","#home","rgb(0, 0, 238)","underline","Streams","search","INPUT","type","aria-label","Search Input","inline-block","clip","icons","\n    ","BUTTON","Prime offers","rgb(239, 239, 239)","hidden","P","Log In","L","Sign Up","S","User Menu","U","player","relative","VIDEO","src","media/motion.webm","muted","art","absolute","IMG","media/badge.png","alt","Channel offline art","file:///noctiluca/fixtures/media/badge.png","row","thumb","media/thumb-1.jpg","Harbour at dusk, a past broadcast","file:///noctiluca/fixtures/media/thumb-1.jpg","SPAN","badge duration","1:02:33","media/thumb-2.jpg","Radar sweep, live now","file:///noctiluca/fixtures/media/thumb-2.jpg","badge live","rgb(233, 25, 22)","LIVE","badge viewers","412 viewers","H2","style","margin: 12px","700","Past broadcasts","panel","error","An error occurred while loading this video.","interstitial","This video is for viewers 18 and over. ","Start watching","Following 1,204 channels.","join","rgb(145, 71, 255)","Join the Streams community! ","Sign up"]},"ax":{"nodes":[{"nodeId":"4","ignored":false,"role":{"type":"internalRole","value":"RootWebArea"},"chromeRole":{"type":"internalRole","value":144},"name":{"ty